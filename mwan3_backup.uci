package mwan3

config rule 'ssh_tunnel1'
	option dest_ip '34.244.201.246'
	option proto 'all'
	option use_policy 'prefer_zitel'

config rule 'ssh_tunnel2'
	option dest_ip '52.209.91.248'
	option proto 'all'
	option use_policy 'prefer_irancell'

config globals 'globals'
	option mmx_mask '0x3F00'

config policy 'balanced'
	option last_resort 'unreachable'
	list use_member 'zitel_mem'
	list use_member 'irancell_mem'
	list use_member 'rightel_mem'
	list use_member 'iphone_mem'
	list use_member 'mobinnet_mem'

config rule 'https'
	option sticky '1'
	option dest_port '443'
	option proto 'tcp'
	option use_policy 'balanced'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'balanced'
	option family 'ipv4'

config rule 'default_rule_v6'
	option dest_ip '::/0'
	option use_policy 'balanced'
	option family 'ipv6'

config member 'zitel_mem'
	option interface 'zitel'
	option metric '2'
	option weight '5'

config interface 'zitel'
	option enabled '1'
	option initial_state 'online'
	option family 'ipv4'
	option track_method 'ping'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '5'
	option failure_interval '5'
	option recovery_interval '3'
	option down '3'
	option up '3'
	option httping_ssl '0'
	list track_ip '185.147.179.11'
	list track_ip '185.188.104.10'

config interface 'wwan_irancell'
	option initial_state 'online'
	option family 'ipv4'
	option track_method 'ping'
	option reliability '1'
	option count '1'
	option size '56'
	option max_ttl '60'
	option timeout '3'
	option interval '10'
	option failure_interval '10'
	option recovery_interval '5'
	option down '5'
	option up '5'
	option enabled '1'
	option httping_ssl '1'
	list track_ip '185.147.179.11'
	list track_ip '185.188.104.10'

config member 'irancell_mem'
	option interface 'wwan_irancell'
	option metric '3'
	option weight '2'

config interface 'RighTel'
	option family 'ipv4'
	option track_method 'ping'
	option reliability '1'
	option initial_state 'online'
	option count '1'
	option timeout '4'
	option interval '3'
	option failure_interval '5'
	option recovery_interval '5'
	option down '3'
	option up '3'
	option enabled '1'
	option httping_ssl '0'
	list track_ip '185.147.179.11'
	list track_ip '185.188.104.10'

config member 'rightel_mem'
	option interface 'RighTel'
	option metric '4'
	option weight '1'

config member 'iphone_mem'
	option interface 'wwan_iphone'
	option metric '1'
	option weight '10'

config policy 'prefer_zitel'
	option last_resort 'unreachable'
	list use_member 'zitel_mem'
	list use_member 'irancell_mem'
	list use_member 'rightel_mem'
	list use_member 'iphone_mem'
	list use_member 'mobinnet_mem'

config policy 'prefer_irancell'
	option last_resort 'unreachable'
	list use_member 'irancell_mem'
	list use_member 'zitel_mem'
	list use_member 'rightel_mem'
	list use_member 'iphone_mem'
	list use_member 'mobinnet_mem'

config interface 'wwan_mobinnet'
	option enabled '1'
	option initial_state 'online'
	option family 'ipv4'
	option track_method 'ping'
	option reliability '1'
	option count '1'
	option size '56'
	option max_ttl '60'
	option timeout '4'
	option interval '10'
	option failure_interval '10'
	option recovery_interval '5'
	option down '5'
	option up '5'
	option httping_ssl '0'
	list track_ip '185.147.179.11'
	list track_ip '185.188.104.10'

config member 'mobinnet_mem'
	option interface 'wwan_mobinnet'
	option metric '6'
	option weight '2'

