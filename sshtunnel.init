#!/bin/sh /etc/rc.common
#
# Principal Banking Data Engineer Standard:
# File: /etc/init.d/sshtunnel
# Directive: Create a robust, persistent SSH tunnel service using autossh and procd.
# Security: Uses a non-root SSH key and logs to the system log.
#           Placeholders are used for sensitive connection details.

# --- Service Configuration ---
USE_PROCD=1
START=99
STOP=10

# --- Tunnel Configuration (Replace Placeholders) ---
REMOTE_SSH_HOST="34.244.201.246"
REMOTE_SSH_USER="ubuntu"
LOCAL_SOCKS_PORT="1088"
TUNNEL_KEY_PATH="/root/.ssh/remote_tunnel_key"

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/autossh

    # --- autossh Configuration ---
    # [Robustness] Pass each argument separately to procd to avoid shell quoting issues.
    procd_set_param command -M 0
    procd_set_param command -N
    procd_set_param command -T
    procd_set_param command -D "${LOCAL_SOCKS_PORT}"
    procd_set_param command -o "ServerAliveInterval 60"
    procd_set_param command -o "ServerAliveCountMax 3"
    procd_set_param command -o "StrictHostKeyChecking=no"
    procd_set_param command -o "ExitOnForwardFailure=yes"
    procd_set_param command -i "${TUNNEL_KEY_PATH}"
    procd_set_param command "${REMOTE_SSH_USER}@${REMOTE_SSH_HOST}"
    
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    
    procd_close_instance
}

stop_service() {
    echo "Stopping SSH tunnel service..."
}

reload_service() {
    stop
    start
}
